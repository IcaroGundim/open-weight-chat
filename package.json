{
  "name": "open-weight-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "build:client": "vite build",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.js --external:node:*",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "design": "node scripts/contrast.mjs && node scripts/audit-design.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.2",
    "@neondatabase/serverless": "^1.1.0",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "hono": "^4.9.7",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.12.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.9",
    "react-grab": "^0.1.50",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
