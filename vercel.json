{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build:client && pnpm build:api",
  "outputDirectory": "dist",
  "functions": {
    "api/entry.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/entry?__route="
    },
    {
      "source": "/api/:route*",
      "destination": "/api/entry?__route=:route*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
