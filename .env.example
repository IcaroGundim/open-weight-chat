PORT=8787
HOST=127.0.0.1
CHAT_DB_PATH=./chat.db

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# Vercel + Neon: use a connection string com pooling copiada do painel Neon.
# Quando DATABASE_URL existe, o servidor usa Postgres em vez do SQLite local
# (em desenvolvimento, sem DATABASE_URL, o app usa SQLite como antes).
DATABASE_URL=

# O schema é versionado em scripts/db/migrations e aplicado com `pnpm db:migrate`
# (status / up --dry-run / up). Não há mais criação automática de tabelas em
# requisições.

# ---------------------------------------------------------------------------
# Clerk — autenticação (Google/e-mail)
# Crie um app em https://dashboard.clerk.com e copie as chaves em
# Dashboard → API Keys. No painel, habilite os provedores de login Google e
# e-mail verificado.
# ---------------------------------------------------------------------------
# Chave secreta do servidor: valida os tokens de sessão enviados no header
# Authorization de toda chamada /api/*.
CLERK_SECRET_KEY=
# Chave publicável (começa com pk_): configuração pública do frontend.
CLERK_PUBLISHABLE_KEY=
# Mesma chave publicável, com o prefixo VITE_ porque é lida pelo Vite no build
# (o Vite só expõe variáveis VITE_* ao código do navegador). Depois de alterar
# qualquer VITE_*, é preciso um novo build/deploy.
VITE_CLERK_PUBLISHABLE_KEY=
# Origem do frontend do Clerk (ex.: https://SEU-APP.clerk.accounts.dev), visível
# no painel Clerk. O servidor a usa para montar o CSP (script-src, connect-src,
# frame-src) e validar origens.
CLERK_FRONTEND_API_ORIGIN=
# Obrigatória no deploy: origem pública EXATA do app, sem caminho, query ou
# fragmento (ex.: https://SEU-PROJETO.vercel.app). Somente ela recebe CORS.
# Em desenvolvimento local pode ficar vazia: o proxy do Vite deixa /api na
# mesma origem do navegador.
APP_ORIGIN=

# ---------------------------------------------------------------------------
# Migração de um deploy existente
# ---------------------------------------------------------------------------
# APENAS durante a migração para o multiusuário: ID user_... (painel Clerk →
# Users) da conta que recebe as conversas e provedores antigos. Remova depois
# da migração.
LEGACY_OWNER_CLERK_USER_ID=

# ---------------------------------------------------------------------------
# Chave-mestra dos provedores
# ---------------------------------------------------------------------------
# Cifra (AES-256-GCM, formato v2 com contexto autenticado userId + providerId)
# as chaves cadastradas na aba "Provedores" das Configurações. Em desenvolvimento
# o servidor cria automaticamente .provider-secret; na Vercel a chave vem só
# desta variável. NUNCA troque depois de haver chaves v2 no banco — as chaves
# não poderão mais ser decifradas.
PROVIDER_SECRET_KEY=

# ---------------------------------------------------------------------------
# Chaves de provedor — SOMENTE DESENVOLVIMENTO
# ---------------------------------------------------------------------------
# Em produção a plataforma não usa chaves de ambiente: cada usuário cadastra a
# própria chave em Configurações → Provedores. As variáveis abaixo só funcionam
# em desenvolvimento local, com ALLOW_ENV_API_KEYS=true — que NUNCA deve ser
# ativado em produção (nem como fallback).
ALLOW_ENV_API_KEYS=false
DEEPSEEK_API_KEY=
ZAI_API_KEY=
KIMI_API_KEY=
OPENROUTER_API_KEY=

# Opcional e somente local: em produção URLs http, localhost e redes privadas
# são bloqueadas. Para Ollama em produção, use endpoint HTTPS público seguro.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# ---------------------------------------------------------------------------
# Provedores personalizados — SOMENTE DESENVOLVIMENTO
# ---------------------------------------------------------------------------
# Qualquer endpoint OpenAI-compatível, sem tocar em código. Duas formas, e as
# duas podem coexistir:
#
#   1. providers.local.json na raiz do projeto (ignorado pelo Git) — melhor
#      para desenvolvimento, porque cabe indentado e comentado.
#   2. CUSTOM_PROVIDERS abaixo, com o mesmo JSON em uma linha.
#
# A CHAVE NUNCA ENTRA NESSE JSON. Entra o NOME da variável de ambiente, em
# "apiKeyEnv", e a chave em si vira outra linha deste arquivo. Um campo
# "apiKey" faz o provedor ser recusado com erro explícito na interface.
#
# "ctx" é obrigatório: é ele que dirige o corte de histórico. Um valor errado
# quebra o truncamento em silêncio, e o erro só aparece como falha do provedor.
# "pricing" é opcional — sem ele o custo aparece como indisponível, o que é
# honesto, em vez de zero, que seria mentira.
#
# Exemplo com o OpenCode Zen (endpoint verificado; confirme os ids de modelo e
# os preços na documentação deles antes de confiar nos números):
#
# CUSTOM_PROVIDERS=[{"id":"opencode","label":"OpenCode Zen","baseURL":"https://opencode.ai/zen/v1","apiKeyEnv":"OPENCODE_API_KEY","verifiedAt":"2026-08-04","models":[{"id":"COLOQUE-O-ID-DA-API","label":"GPT 5.6 Luna","ctx":272000,"reasoning":true,"pricing":{"inputPerMillion":0.2,"outputPerMillion":1.2}}]}]
# OPENCODE_API_KEY=
CUSTOM_PROVIDERS=
